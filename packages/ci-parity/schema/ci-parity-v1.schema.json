{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umbraculum.dev/schemas/ci-parity/v1.json",
  "title": "Umbraculum CI Parity Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "profile", "runtime", "snapshot", "install", "jobs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profile": {
      "enum": ["ts-npm-monorepo", "python", "magento-php"]
    },
    "runtime": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": { "type": "string" },
        "nodeOptions": { "type": "string" }
      }
    },
    "docker": {
      "type": "object",
      "properties": {
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "containerPath"],
            "properties": {
              "name": { "type": "string" },
              "containerPath": { "type": "string" }
            }
          },
          "default": []
        },
        "resources": {
          "type": "object",
          "description": "Optional Docker / parallel caps (laptop defaults apply when omitted)",
          "properties": {
            "memory": { "type": "string", "description": "Docker --memory (e.g. 2560m)" },
            "cpus": { "type": "string", "description": "Docker --cpus (e.g. 2)" },
            "maxParallel": {
              "type": "integer",
              "minimum": 1,
              "description": "Max concurrent job containers under --parallel"
            }
          }
        }
      },
      "default": { "volumes": [] }
    },
    "snapshot": {
      "type": "object",
      "required": ["local", "ci"],
      "properties": {
        "local": { "const": "git-archive" },
        "ci": { "const": "checkout" }
      }
    },
    "install": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": { "type": "string" },
        "nested": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "command", "afterJob", "beforeJob"],
            "properties": {
              "path": { "type": "string" },
              "command": { "type": "string" },
              "afterJob": { "type": "string" },
              "beforeJob": { "type": "string" }
            }
          }
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1
    }
  }
}
